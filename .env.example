# ===== CyberShield Environment Variables =====
# คัดลอกไฟล์นี้เป็น .env แล้วเปลี่ยนค่าตามต้องการ

# Auth — ข้อมูล login สำหรับ admin dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-strong-password

# Session secret — ใช้สร้าง session cookie (ต้องยาว ≥ 32 ตัวอักษร)
SESSION_SECRET=your-random-secret-key-32chars-minimum

# Internal IPC secret — shared secret ระหว่าง sensor กับ FastAPI
INTERNAL_TOKEN=your-internal-secret

# Alert thresholds (per-model) — ค่า confidence ขั้นต่ำที่จะถือว่าเป็น Alert
THRESHOLD_INTRUSION=0.85
THRESHOLD_FLOW=0.80
THRESHOLD_SQLI=0.75

# Network interface สำหรับ nfstream capture
NETWORK_INTERFACE=eth0
